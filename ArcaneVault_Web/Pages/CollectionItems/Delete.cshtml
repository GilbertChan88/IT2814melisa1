@page "{id:int}"
@model ArcaneVault_Web.Pages.CollectionItems.DeleteModel

@{
    ViewData["Title"] = "Remove Collection Item";
}

<h2>Remove Collection Item</h2>

<div asp-validation-summary="ModelOnly"
     class="text-danger"></div>

@if (Model.CollectionItem != null)
{
    <div class="alert alert-warning">
        Are you sure you want to remove this item from your collection?
    </div>

    <dl class="row">

        <dt class="col-sm-3">
            Item Name
        </dt>
        <dd class="col-sm-9">
            @Model.CollectionItem.ItemName
        </dd>

        <dt class="col-sm-3">
            Category
        </dt>
        <dd class="col-sm-9">
            @(Model.CollectionItem.CategoryName ?? "Not assigned")
        </dd>

        <dt class="col-sm-3">
            Current Quantity
        </dt>
        <dd class="col-sm-9">
            @Model.CollectionItem.CurrentQuantity
        </dd>

    </dl>

    <form method="post">
        <button type="submit"
                class="btn btn-danger">
            Remove
        </button>

        <a asp-page="Index"
           class="btn btn-secondary">
            Cancel
        </a>
    </form>
}
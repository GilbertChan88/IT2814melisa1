@page
@model ArcaneVault_Web.Pages.CollectionItems.IndexModel
@using ArcaneVault_Web.Models

@{
    ViewData["Title"] = "My Collection";
    var valuation = Model.Valuation;
}

<div class="page-header">
    <div>
        <h2>My Collection</h2>
        <p class="page-subtitle">Everything you own, graded and valued.</p>
    </div>
    <div class="header-actions-group">
        <a asp-page="/Dashboard/Index" class="btn btn-outline-secondary">Dashboard</a>
        <a asp-page="Available" class="btn btn-accent">+ Add items</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert-success" role="status">@Model.StatusMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert-danger" role="alert">@Model.ErrorMessage</div>
}

@if (valuation.DistinctItems > 0)
{
    <section class="valuation-panel valuation-panel-compact">
        <div class="valuation-primary">
            <div class="valuation-label">Portfolio value</div>
            <div class="valuation-amount">@valuation.TotalValue.ToString("C")</div>
            <div class="valuation-sub">
                @valuation.DistinctItems @(valuation.DistinctItems == 1 ? "item" : "items")
                &middot; @valuation.TotalUnits @(valuation.TotalUnits == 1 ? "unit" : "units")
            </div>
        </div>
        <div class="valuation-metrics">
            <div class="valuation-metric">
                <span class="metric-label">Spent</span>
                <span class="metric-value">@valuation.TotalSpent.ToString("C")</span>
            </div>
            <div class="valuation-metric">
                <span class="metric-label">@(valuation.IsGain ? "Gain" : "Loss")</span>
                <span class="metric-value @(valuation.IsGain ? "value-up" : "value-down")">
                    @(valuation.IsGain ? "+" : "")@valuation.UnrealisedGain.ToString("C")
                    <span class="metric-percent">
                        (@(valuation.GainPercent >= 0 ? "+" : "")@valuation.GainPercent.ToString("0.0")%)
                    </span>
                </span>
            </div>
        </div>
    </section>
}

<form method="get" class="filter-panel filter-panel-compact">
    <div class="filter-row">
        <div class="filter-field filter-search">
            <label asp-for="SearchString" class="form-label">Search</label>
            <input asp-for="SearchString" class="form-control"
                   placeholder="Name, category or notes&hellip;" />
        </div>
        <div class="filter-field">
            <label asp-for="ConditionFilter" class="form-label">Condition</label>
            <select asp-for="ConditionFilter" class="form-select">
                <option value="">Any condition</option>
                @foreach (var condition in Enum.GetValues<ItemCondition>())
                {
                    <option value="@((int)condition)">@condition.ToString()</option>
                }
            </select>
        </div>
        <div class="filter-field">
            <label asp-for="Sort" class="form-label">Sort by</label>
            <select asp-for="Sort" class="form-select">
                @foreach (var (value, label) in ArcaneVault_Web.Pages.CollectionItems.IndexModel.SortOptions)
                {
                    <option value="@value">@label</option>
                }
            </select>
        </div>
        <div class="filter-field filter-field-actions">
            <button type="submit" class="btn btn-accent">Apply</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

@if (Model.CollectionItemList.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#128230;</div>
        <strong>Nothing to show</strong>
        <p>
            @if (!string.IsNullOrWhiteSpace(Model.SearchString) || Model.ConditionFilter.HasValue)
            {
                <span>No items match your filters.</span>
            }
            else
            {
                <span>Start adding items from the catalogue to build your collection.</span>
            }
        </p>
        <a asp-page="Available" class="btn btn-primary">Browse catalogue</a>
    </div>
}
else
{
    <div class="product-grid">
        @foreach (var item in Model.CollectionItemList)
        {
            var imageSrc = item.ResolvedImageUrl
                ?? Url.Content("~/images/product-placeholder.png");

            <article class="product-card">
                <img src="@imageSrc" alt="@item.ItemName" loading="lazy" />
                <div class="card-body">
                    <div class="title">@item.ItemName</div>
                    <div class="meta">@(item.CategoryName ?? "Not assigned")</div>

                    <div class="card-meta-row">
                        <span class="pill pill-muted">@item.DisplayCondition</span>
                        <span class="text-muted-small">&times;@item.CurrentQuantity</span>
                    </div>

                    <div class="holding-values">
                        <div class="holding-value-row">
                            <span class="text-muted-small">Value</span>
                            <span class="price">@item.TotalValue.ToString("C")</span>
                        </div>
                        @if (item.PurchasePrice.HasValue)
                        {
                            <div class="holding-value-row">
                                <span class="text-muted-small">Paid</span>
                                <span class="text-muted-small">@item.TotalSpent.ToString("C")</span>
                            </div>
                            <div class="holding-value-row">
                                <span class="text-muted-small">Gain</span>
                                <span class="@(item.Gain >= 0 ? "value-up" : "value-down")">
                                    @(item.Gain >= 0 ? "+" : "")@item.Gain.ToString("C")
                                </span>
                            </div>
                        }
                    </div>

                    <div class="card-actions card-actions-stack">
                        <a asp-page="Details" asp-route-id="@item.ItemId"
                           class="btn btn-outline-secondary btn-sm">Details</a>
                        <a asp-page="Edit" asp-route-id="@item.ItemId"
                           class="btn btn-warning btn-sm">Edit</a>
                        <a asp-page="Delete" asp-route-id="@item.ItemId"
                           class="btn btn-danger btn-sm">Remove</a>
                    </div>
                </div>
            </article>
        }
    </div>
}

@page
@model ArcaneVault_Web.Pages.CollectionItems.EditModel
@using ArcaneVault_Web.Models

@{
    ViewData["Title"] = "Edit Holding";
}

<div class="page-header">
    <div>
        <h2>Edit Holding</h2>
        <p class="page-subtitle">Update quantity, grading and valuation.</p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary">Back to collection</a>
</div>

@if (Model.CollectionItem == null)
{
    <div class="empty-state">
        <div class="empty-icon">&#9888;</div>
        <strong>Holding not found</strong>
        <a asp-page="Index" class="btn btn-primary">Back to collection</a>
    </div>
}
else
{
    var item = Model.CollectionItem;
    var imageSrc = item.ResolvedImageUrl ?? Url.Content("~/images/product-placeholder.png");

    <div class="add-collection-layout">
        <aside class="add-collection-preview">
            <img src="@imageSrc" alt="@item.ItemName" />
            <h3 class="preview-title">@item.ItemName</h3>
            <div class="meta">@(item.CategoryName ?? "Not assigned")</div>
            <dl class="preview-facts">
                <div>
                    <dt>Originally added</dt>
                    <dd>@item.StartingQuantity units</dd>
                </div>
                @if (item.CreatedAt != default)
                {
                    <div>
                        <dt>In collection since</dt>
                        <dd>@item.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</dd>
                    </div>
                }
            </dl>
        </aside>

        <div class="sell-form-container">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Input.ItemId" />

                <div class="form-row-2">
                    <div class="mb-3">
                        <label asp-for="Input.CurrentQuantity" class="form-label"></label>
                        <input asp-for="Input.CurrentQuantity" class="form-control"
                               type="number" min="0" />
                        <span asp-validation-for="Input.CurrentQuantity" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Condition" class="form-label"></label>
                        <select asp-for="Input.Condition" class="form-select"
                                asp-items="Html.GetEnumSelectList<ItemCondition>()"></select>
                        <span asp-validation-for="Input.Condition" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="mb-3">
                        <label asp-for="Input.PurchasePrice" class="form-label"></label>
                        <input asp-for="Input.PurchasePrice" class="form-control"
                               type="number" step="0.01" min="0" />
                        <span asp-validation-for="Input.PurchasePrice" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.EstimatedValue" class="form-label"></label>
                        <input asp-for="Input.EstimatedValue" class="form-control"
                               type="number" step="0.01" min="0" />
                        <span asp-validation-for="Input.EstimatedValue" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.AcquiredAt" class="form-label"></label>
                    <input asp-for="Input.AcquiredAt" class="form-control" type="date"
                           value="@(Model.Input.AcquiredAt?.ToString("yyyy-MM-dd"))" />
                    <span asp-validation-for="Input.AcquiredAt" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.Notes" class="form-label"></label>
                    <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Input.Notes" class="text-danger"></span>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-accent">Save changes</button>
                    <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page "{id:int}"
@model ArcaneVault_Web.Pages.CollectionItems.EditModel

@{
    ViewData["Title"] = "Edit Collection Item";
}

<h2>Edit Collection Item</h2>

<form method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <input asp-for="ItemId" type="hidden" />

    <div class="mb-3">
        <label class="form-label">
            Item Name
        </label>

        <input value="@Model.CollectionItem?.ItemName"
               class="form-control"
               readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">
            Category
        </label>

        <input value="@Model.CollectionItem?.CategoryName"
               class="form-control"
               readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">
            Starting Quantity
        </label>

        <input value="@Model.CollectionItem?.StartingQuantity"
               class="form-control"
               readonly />
    </div>

    <div class="mb-3">
        <label asp-for="CurrentQuantity"
               class="form-label">
            Current Quantity
        </label>

        <input asp-for="CurrentQuantity"
               class="form-control" />

        <span asp-validation-for="CurrentQuantity"
              class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Save
    </button>

    <a asp-page="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
@page
@model ArcaneVault_Web.Pages.CollectionItems.AvailableModel

@{
    ViewData["Title"] = "Available Items";
}

<h2>Available Items</h2>

<p>
    Select an item created by the administrator and add it to
    your personal collection.
</p>

<form method="get" class="mb-3">
    <div class="input-group">
        <input asp-for="SearchString"
               class="form-control"
               placeholder="Search by item name or category..." />

        <button type="submit" class="btn btn-primary">
            Search
        </button>

        <a asp-page="Available"
           class="btn btn-secondary">
            Clear
        </a>
    </div>
</form>

@if (Model.CatalogItemList.Count == 0)
{
    <div class="alert alert-info">
        No available items found.
    </div>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Item Name</th>
                <th>Category</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.CatalogItemList)
            {
                <tr>
                    <td>@item.ItemName</td>
                    <td>@item.CategoryName</td>

                    <td>
                        <a asp-page="Add"
                           asp-route-id="@item.CatalogItemId"
                           class="btn btn-success">
                            Add to Collection
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
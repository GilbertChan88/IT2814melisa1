@page
@model IndexModel
@using ArcaneVault_Web.Models

@{
    ViewData["Title"] = "Home";
}

<!-- Hero -->
<section class="hero">
    <div class="hero-content">
        @if (Model.IsSignedIn)
        {
            <h1>Welcome back, @Model.UserName</h1>
            @if (Model.Valuation != null && Model.Valuation.DistinctItems > 0)
            {
                <p>
                    Your collection is worth
                    <strong>@Model.Valuation.TotalValue.ToString("C")</strong>
                    across @Model.Valuation.TotalUnits
                    @(Model.Valuation.TotalUnits == 1 ? "unit" : "units").
                </p>
            }
            else
            {
                <p>Start building your collection &mdash; add your first item below.</p>
            }
        }
        else
        {
            <h1>Discover Rare Collectibles</h1>
            <p>
                Action figures, trading cards, statues and pop culture memorabilia
                &mdash; all in stock and ready to ship.
            </p>
        }

        <p class="hero-cta">
            <a class="btn btn-primary btn-lg me-2" asp-page="/CollectionItems/Available">
                Shop Now
            </a>
            @if (Model.IsSignedIn)
            {
                <a class="btn btn-outline-secondary btn-lg" asp-page="/Dashboard/Index">
                    My Dashboard
                </a>
            }
            else
            {
                <a class="btn btn-outline-secondary btn-lg" asp-page="/SellWithUs/Index">
                    Sell with Us
                </a>
            }
        </p>
    </div>
    <div class="hero-media d-none d-lg-block">
        <div class="placeholder-img">&#127922; Collectibles</div>
    </div>
</section>

<!-- Trust badges -->
<section class="trust-badges">
    <div class="trust-badge">
        <div class="badge-icon">&#128230;</div>
        <div class="badge-title">In-Stock &amp; Ready</div>
        <div class="badge-desc">Every item ships within 1-3 business days</div>
    </div>
    <div class="trust-badge">
        <div class="badge-icon">&#9989;</div>
        <div class="badge-title">Reviewed Listings</div>
        <div class="badge-desc">Seller submissions are checked before going live</div>
    </div>
    <div class="trust-badge">
        <div class="badge-icon">&#128276;</div>
        <div class="badge-title">Restock Alerts</div>
        <div class="badge-desc">Get notified the moment a sold-out item returns</div>
    </div>
    <div class="trust-badge">
        <div class="badge-icon">&#8646;</div>
        <div class="badge-title">Collector Trading</div>
        <div class="badge-desc">Swap duplicates directly with other members</div>
    </div>
</section>

<!-- New arrivals -->
<section class="mt-section">
    <div class="section-heading">
        <h3>New Arrivals</h3>
        <a class="view-all" asp-page="/CollectionItems/Available"
           asp-route-Sort="newest">View all &rarr;</a>
    </div>

    @if (Model.NewArrivals.Count == 0)
    {
        <div class="alert-info">
            No items available right now. Check back soon.
        </div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var item in Model.NewArrivals)
            {
                var imageSrc = item.ResolvedImageUrl
                    ?? Url.Content("~/images/product-placeholder.png");

                <article class="product-card">
                    @if (item.InStock)
                    {
                        <div class="badge-stock">In Stock</div>
                    }
                    else
                    {
                        <div class="badge-oos">Out of stock</div>
                    }

                    <a asp-page="/CatalogItems/Details" asp-route-id="@item.CatalogItemId"
                       class="product-image-link">
                        <img src="@imageSrc" alt="@item.ItemName" loading="lazy" />
                    </a>

                    <div class="card-body">
                        <a asp-page="/CatalogItems/Details" asp-route-id="@item.CatalogItemId"
                           class="title-link">
                            <div class="title">@item.ItemName</div>
                        </a>
                        <div class="meta">@(item.CategoryName ?? item.CategoryCode)</div>

                        @await Html.PartialAsync("_StarRating", new StarRatingViewModel { Rating = item.AverageRating, ReviewCount = item.ReviewCount })

                        <div class="price-row">
                            <span class="price">@item.Price.ToString("C")</span>
                            @if (Model.WishlistIds.Contains(item.CatalogItemId))
                            {
                                <span class="saved-flag" title="On your wishlist">&hearts;</span>
                            }
                        </div>

                        <a asp-page="/CatalogItems/Details" asp-route-id="@item.CatalogItemId"
                           class="btn-add">View item</a>
                    </div>
                </article>
            }
        </div>
    }
</section>

<!-- Top rated -->
@if (Model.TopRated.Any(i => i.ReviewCount > 0))
{
    <section class="mt-section">
        <div class="section-heading">
            <h3>Highest Rated</h3>
            <a class="view-all" asp-page="/CollectionItems/Available"
               asp-route-Sort="rating">View all &rarr;</a>
        </div>

        <ul class="rank-list rank-list-inline">
            @foreach (var item in Model.TopRated.Where(i => i.ReviewCount > 0))
            {
                <li class="rank-row">
                    <img src="@(item.ResolvedImageUrl ?? Url.Content("~/images/product-placeholder.png"))"
                         alt="@item.ItemName" loading="lazy" />
                    <div class="rank-info">
                        <a asp-page="/CatalogItems/Details" asp-route-id="@item.CatalogItemId"
                           class="title-link">@item.ItemName</a>
                        @await Html.PartialAsync("_StarRating", new StarRatingViewModel { Rating = item.AverageRating, ReviewCount = item.ReviewCount })
                    </div>
                    <div class="rank-metric">
                        <strong>@item.Price.ToString("C")</strong>
                    </div>
                </li>
            }
        </ul>
    </section>
}

<!-- Categories -->
<section class="mt-section mb-section">
    <div class="section-heading">
        <h3>Browse by Category</h3>
        <a class="view-all" asp-page="/CollectionItems/Available">Shop all &rarr;</a>
    </div>
    <div class="category-pills">
        @if (Model.CategoryList.Count == 0)
        {
            <span class="text-muted-small">No categories available.</span>
        }
        else
        {
            @foreach (var category in Model.CategoryList)
            {
                <a class="category-pill" asp-page="/CollectionItems/Available"
                   asp-route-CategoryCode="@category.CategoryCode">@category.CategoryName</a>
            }
        }
    </div>
</section>

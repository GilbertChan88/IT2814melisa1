@page "{id}"
@model ArcaneVault_Web.Pages.Categories.EditModel

<h2>Edit Category</h2>

<form method="post">

    <div class="mb-3">
        <label>Category Code</label>
        <input asp-for="Category.CategoryCode" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label>Category Name</label>
        <input asp-for="Category.CategoryName" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Save
    </button>

</form>
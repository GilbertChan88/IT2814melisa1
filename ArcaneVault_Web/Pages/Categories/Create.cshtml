@page
@model ArcaneVault_Web.Pages.Categories.CreateModel

<h2>Create Category</h2>

<form method="post">

    <div class="mb-3">
        <label>Category Code</label>
        <input asp-for="Category.CategoryCode" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Category Name</label>
        <input asp-for="Category.CategoryName" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Create
    </button>

</form>
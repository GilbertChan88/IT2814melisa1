@page
@model ArcaneVault_Web.Pages.Categories.IndexModel

<h2>Categories</h2>

<p>
    <a asp-page="Create" class="btn btn-success">
        Create New Category
    </a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>         
            <th>Category Code</th>
            <th>Category Name</th>
            <th>Actions</th>
        </tr>
    </thead>
   <tbody>
    @foreach (var category in Model.CategoryList)
    {
        <tr>
            <td>@category.CategoryCode</td>
            <td>@category.CategoryName</td>
                <td>
                    <a asp-page="Details"
                       asp-route-id="@category.CategoryCode"
                       class="btn btn-info">
                        Details
                    </a>

                    <a asp-page="Edit"
                       asp-route-id="@category.CategoryCode"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-page="Delete"
                       asp-route-id="@category.CategoryCode"
                       class="btn btn-danger">
                        Delete
                    </a>
                </td>
        </tr>
    }
</tbody>
</table>
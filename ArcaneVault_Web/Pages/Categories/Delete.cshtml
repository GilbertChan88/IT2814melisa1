@page "{id}"
@model ArcaneVault_Web.Pages.Categories.DeleteModel

<h2>Delete Category</h2>

<h4>Are you sure you want to delete this category?</h4>

<div>
    <dl class="row">
        <dt class="col-sm-2">Category Code</dt>
        <dd class="col-sm-10">@Model.Category.CategoryCode</dd>

        <dt class="col-sm-2">Category Name</dt>
        <dd class="col-sm-10">@Model.Category.CategoryName</dd>
    </dl>
</div>

<form method="post">
    <input type="hidden" asp-for="Category.CategoryCode" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-page="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>
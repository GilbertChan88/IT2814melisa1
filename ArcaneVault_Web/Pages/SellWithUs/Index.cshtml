@page
@model ArcaneVault_Web.Pages.SellWithUs.IndexModel

@{
    ViewData["Title"] = "Sell with Us";
}

<div class="page-header">
    <div>
        <h2>Sell with Us</h2>
        <p class="page-subtitle">
            List your spare collectibles for other collectors.
        </p>
    </div>
    <a asp-page="MyListings" class="btn btn-outline-secondary">My listings</a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="sell-info-section">
    <div class="sell-info-content">
        <h3>How listing works</h3>
        <p>
            Fill in the details below and an admin reviews your listing before it
            goes live. You'll get a notification either way, and if something
            needs changing we'll tell you exactly what.
        </p>
        <div class="sell-features">
            <div class="sell-feature">
                <span class="sell-feature-icon">&#128176;</span>
                <div>
                    <strong>Set your price</strong>
                    <span>You decide the asking price and quantity</span>
                </div>
            </div>
            <div class="sell-feature">
                <span class="sell-feature-icon">&#128269;</span>
                <div>
                    <strong>Reviewed before listing</strong>
                    <span>Keeps the catalogue trustworthy for buyers</span>
                </div>
            </div>
            <div class="sell-feature">
                <span class="sell-feature-icon">&#128276;</span>
                <div>
                    <strong>You'll be notified</strong>
                    <span>Approval or feedback lands in your notifications</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="sell-form-container">
    <h3 class="form-section-title">Item details</h3>

    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="CatalogItem.ItemName" class="form-label"></label>
            <input asp-for="CatalogItem.ItemName" class="form-control"
                   placeholder="e.g. Marvel Legends Spider-Man 6-Inch Figure" />
            <span asp-validation-for="CatalogItem.ItemName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CatalogItem.CategoryCode" class="form-label"></label>
            @if (Model.CategoryList.Count == 0)
            {
                <div class="alert-info">
                    No categories are available right now. Please try again later.
                </div>
            }
            else
            {
                <select asp-for="CatalogItem.CategoryCode" class="form-select">
                    <option value="">-- Select a category --</option>
                    @foreach (var category in Model.CategoryList)
                    {
                        <option value="@category.CategoryCode">@category.CategoryName</option>
                    }
                </select>
            }
            <span asp-validation-for="CatalogItem.CategoryCode" class="text-danger"></span>
        </div>

        <div class="form-row-2">
            <div class="mb-3">
                <label asp-for="CatalogItem.Price" class="form-label"></label>
                <input asp-for="CatalogItem.Price" class="form-control"
                       type="number" step="0.01" min="0" placeholder="0.00" />
                <span asp-validation-for="CatalogItem.Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CatalogItem.StockQuantity" class="form-label"></label>
                <input asp-for="CatalogItem.StockQuantity" class="form-control"
                       type="number" min="0" />
                <span asp-validation-for="CatalogItem.StockQuantity" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="CatalogItem.Description" class="form-label"></label>
            <textarea asp-for="CatalogItem.Description" class="form-control" rows="4"
                      placeholder="Condition, packaging, anything a buyer should know&hellip;"></textarea>
            <span asp-validation-for="CatalogItem.Description" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label class="form-label">Product image (optional)</label>
            <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
            <small class="form-hint">
                A clear photo helps your listing sell. JPG or PNG.
            </small>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-accent">Submit for review</button>
            <a asp-page="/Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

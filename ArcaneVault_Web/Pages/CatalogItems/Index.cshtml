@page
@model ArcaneVault_Web.Pages.CatalogItems.IndexModel

@{
    ViewData["Title"] = "Manage Items";
}

<h2>Manage Items</h2>

<p>
    <a asp-page="Create" class="btn btn-success">
        Create New Item
    </a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Item ID</th>
            <th>Item Name</th>
            <th>Category</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.CatalogItemList)
        {
            <tr>
                <td>@item.CatalogItemId</td>
                <td>@item.ItemName</td>
                <td>@item.CategoryName</td>

                <td>
                    <a asp-page="Details"
                       asp-route-id="@item.CatalogItemId"
                       class="btn btn-info">
                        Details
                    </a>

                    <a asp-page="Edit"
                       asp-route-id="@item.CatalogItemId"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-page="Delete"
                       asp-route-id="@item.CatalogItemId"
                       class="btn btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
@page
@model ArcaneVault_Web.Pages.CatalogItems.IndexModel
@using ArcaneVault_Web.Models

@{
    ViewData["Title"] = "Manage Catalogue";
}

<div class="page-header">
    <div>
        <h2>Manage Catalogue</h2>
        <p class="page-subtitle">
            Every listing, including items still awaiting review.
        </p>
    </div>
    <div class="header-actions-group">
        <a asp-page="/Admin/Submissions" class="btn btn-outline-secondary">Approval queue</a>
        <a asp-page="Create" class="btn btn-accent">+ New item</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert-success" role="status">@Model.StatusMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert-danger" role="alert">@Model.ErrorMessage</div>
}

<form method="get" class="filter-panel filter-panel-compact">
    <input type="hidden" name="PageNumber" value="1" />
    <div class="filter-row">
        <div class="filter-field filter-search">
            <label asp-for="SearchString" class="form-label">Search</label>
            <input asp-for="SearchString" name="Search" class="form-control"
                   placeholder="Item name or description&hellip;" />
        </div>
        <div class="filter-field">
            <label asp-for="CategoryCode" class="form-label">Category</label>
            <select asp-for="CategoryCode" class="form-select">
                <option value="">All categories</option>
                @foreach (var category in Model.CategoryList)
                {
                    <option value="@category.CategoryCode">@category.CategoryName</option>
                }
            </select>
        </div>
        <div class="filter-field">
            <label asp-for="StatusFilter" class="form-label">Status</label>
            <select asp-for="StatusFilter" class="form-select">
                <option value="">All statuses</option>
                @foreach (var (value, label) in ArcaneVault_Web.Pages.CatalogItems.IndexModel.StatusOptions)
                {
                    <option value="@value">@label</option>
                }
            </select>
        </div>
        <div class="filter-field filter-field-actions">
            <button type="submit" class="btn btn-accent">Apply</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

@if (Model.Results.Items.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#128203;</div>
        <strong>No items found</strong>
        <p>Nothing matches these filters.</p>
        <a asp-page="Create" class="btn btn-primary">Create an item</a>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="table-dark-custom">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Category</th>
                    <th class="num">Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th class="num">Rating</th>
                    <th class="num">Views</th>
                    <th class="actions-col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Results.Items)
                {
                    <tr>
                        <td>
                            <div class="table-item-cell">
                                <img src="@(item.ResolvedImageUrl ?? Url.Content("~/images/product-placeholder.png"))"
                                     alt="@item.ItemName" class="table-thumb" loading="lazy" />
                                <div>
                                    <a asp-page="Details" asp-route-id="@item.CatalogItemId"
                                       class="title-link">@item.ItemName</a>
                                    <div class="text-muted-small">
                                        #@item.CatalogItemId
                                        @if (!string.IsNullOrWhiteSpace(item.SubmittedBy))
                                        {
                                            <span>&middot; by @item.SubmittedBy</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="category-pill">
                                @(item.CategoryName ?? item.CategoryCode)
                            </span>
                        </td>
                        <td class="num">@item.Price.ToString("C")</td>
                        <td>
                            <form method="post" asp-page-handler="UpdateStock" class="stock-form">
                                <input type="hidden" name="catalogItemId" value="@item.CatalogItemId" />
                                <input type="hidden" name="PageNumber" value="@Model.Results.Page" />
                                <input type="hidden" name="Search" value="@Model.SearchString" />
                                <input type="hidden" name="CategoryCode" value="@Model.CategoryCode" />
                                <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                <label class="visually-hidden" for="stock-@item.CatalogItemId">
                                    Stock quantity
                                </label>
                                <input id="stock-@item.CatalogItemId" name="stockQuantity"
                                       type="number" min="0" value="@item.StockQuantity"
                                       class="form-control stock-input" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm">
                                    Set
                                </button>
                            </form>
                            @if (!item.InStock)
                            {
                                <div class="text-muted-small stock-note">Out of stock</div>
                            }
                        </td>
                        <td>
                            <span class="pill @(item.Status switch {
                                0 => "status-pending",
                                1 => "status-delivered",
                                2 => "status-cancelled",
                                _ => "status-pending" })">@item.StatusName</span>
                        </td>
                        <td class="num">
                            @if (item.ReviewCount > 0)
                            {
                                <span>@item.AverageRating.ToString("0.0")</span>
                                <span class="text-muted-small">(@item.ReviewCount)</span>
                            }
                            else
                            {
                                <span class="text-muted-small">&ndash;</span>
                            }
                        </td>
                        <td class="num">@item.ViewCount</td>
                        <td class="actions-col">
                            <div class="table-actions">
                                <a asp-page="Edit" asp-route-id="@item.CatalogItemId"
                                   class="btn btn-warning btn-sm">Edit</a>
                                <a asp-page="Delete" asp-route-id="@item.CatalogItemId"
                                   class="btn btn-danger btn-sm">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination", new PaginationViewModel { CurrentPage = Model.Results.Page, TotalPages = Model.Results.TotalPages, TotalCount = Model.Results.TotalCount, FirstItemOnPage = Model.Results.FirstItemOnPage, LastItemOnPage = Model.Results.LastItemOnPage, PageName = "/CatalogItems/Index", RouteValues = Model.RouteValuesForPage(1) })
}

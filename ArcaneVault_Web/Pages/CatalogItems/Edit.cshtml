@page "{id:int}"
@model ArcaneVault_Web.Pages.CatalogItems.EditModel

@{
    ViewData["Title"] = "Edit Item";
}

<div class="page-header">
    <div>
        <h2>Edit Catalogue Item</h2>
        <p class="page-subtitle">
            Raising stock above zero notifies everyone watching this item.
        </p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary">Back to catalogue</a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="add-collection-layout">
    <aside class="add-collection-preview">
        <img src="@(Model.CatalogItem.ResolvedImageUrl ?? Url.Content("~/images/product-placeholder.png"))"
             alt="@Model.CatalogItem.ItemName" />
        <h3 class="preview-title">@Model.CatalogItem.ItemName</h3>
        <dl class="preview-facts">
            <div>
                <dt>Status</dt>
                <dd>@Model.CatalogItem.StatusName</dd>
            </div>
            <div>
                <dt>Views</dt>
                <dd>@Model.CatalogItem.ViewCount</dd>
            </div>
            @if (Model.CatalogItem.ReviewCount > 0)
            {
                <div>
                    <dt>Rating</dt>
                    <dd>
                        @Model.CatalogItem.AverageRating.ToString("0.0")
                        (@Model.CatalogItem.ReviewCount)
                    </dd>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.CatalogItem.SubmittedBy))
            {
                <div>
                    <dt>Submitted by</dt>
                    <dd>@Model.CatalogItem.SubmittedBy</dd>
                </div>
            }
        </dl>
    </aside>

    <div class="sell-form-container">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input asp-for="CatalogItem.CatalogItemId" type="hidden" />

            <div class="mb-3">
                <label asp-for="CatalogItem.ItemName" class="form-label"></label>
                <input asp-for="CatalogItem.ItemName" class="form-control" />
                <span asp-validation-for="CatalogItem.ItemName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CatalogItem.CategoryCode" class="form-label"></label>
                <select asp-for="CatalogItem.CategoryCode" class="form-select">
                    <option value="">-- Select category --</option>
                    @foreach (var category in Model.CategoryList)
                    {
                        <option value="@category.CategoryCode">@category.CategoryName</option>
                    }
                </select>
                <span asp-validation-for="CatalogItem.CategoryCode" class="text-danger"></span>
            </div>

            <div class="form-row-2">
                <div class="mb-3">
                    <label asp-for="CatalogItem.Price" class="form-label"></label>
                    <input asp-for="CatalogItem.Price" class="form-control"
                           type="number" step="0.01" min="0" />
                    <span asp-validation-for="CatalogItem.Price" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CatalogItem.StockQuantity" class="form-label"></label>
                    <input asp-for="CatalogItem.StockQuantity" class="form-control"
                           type="number" min="0" />
                    <span asp-validation-for="CatalogItem.StockQuantity" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="CatalogItem.Description" class="form-label"></label>
                <textarea asp-for="CatalogItem.Description" class="form-control"
                          rows="4"></textarea>
                <span asp-validation-for="CatalogItem.Description" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label class="form-label">Replace image (optional)</label>
                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                <small class="form-hint">Leave empty to keep the current image.</small>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-accent">Save changes</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model ArcaneVault_Web.Models.PaginationViewModel
@*
    Note: loop variables must not be named "page" — Razor would parse "@page"
    as the page directive rather than an expression.
*@
@if (Model.TotalCount > 0)
{
    <nav class="pagination-bar" aria-label="Pagination">
        <div class="pagination-summary">
            Showing <strong>@Model.FirstItemOnPage</strong>&ndash;<strong>@Model.LastItemOnPage</strong>
            of <strong>@Model.TotalCount</strong>
        </div>

        @if (Model.TotalPages > 1)
        {
            var window = Model.PageWindow().ToList();

            <ul class="pagination-list">
                <li>
                    @if (Model.HasPrevious)
                    {
                        <a asp-page="@Model.PageName"
                           asp-all-route-data="@Model.RouteValuesFor(Model.CurrentPage - 1)"
                           class="page-link" rel="prev">&larr; Prev</a>
                    }
                    else
                    {
                        <span class="page-link disabled">&larr; Prev</span>
                    }
                </li>

                @if (!window.Contains(1))
                {
                    <li>
                        <a asp-page="@Model.PageName"
                           asp-all-route-data="@Model.RouteValuesFor(1)"
                           class="page-link">1</a>
                    </li>
                    <li><span class="page-ellipsis">&hellip;</span></li>
                }

                @foreach (var pageNumber in window)
                {
                    <li>
                        @if (pageNumber == Model.CurrentPage)
                        {
                            <span class="page-link active" aria-current="page">@pageNumber</span>
                        }
                        else
                        {
                            <a asp-page="@Model.PageName"
                               asp-all-route-data="@Model.RouteValuesFor(pageNumber)"
                               class="page-link">@pageNumber</a>
                        }
                    </li>
                }

                @if (!window.Contains(Model.TotalPages))
                {
                    <li><span class="page-ellipsis">&hellip;</span></li>
                    <li>
                        <a asp-page="@Model.PageName"
                           asp-all-route-data="@Model.RouteValuesFor(Model.TotalPages)"
                           class="page-link">@Model.TotalPages</a>
                    </li>
                }

                <li>
                    @if (Model.HasNext)
                    {
                        <a asp-page="@Model.PageName"
                           asp-all-route-data="@Model.RouteValuesFor(Model.CurrentPage + 1)"
                           class="page-link" rel="next">Next &rarr;</a>
                    }
                    else
                    {
                        <span class="page-link disabled">Next &rarr;</span>
                    }
                </li>
            </ul>
        }
    </nav>
}

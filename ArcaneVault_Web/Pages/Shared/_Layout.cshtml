@using ArcaneVault_Web
@using ArcaneVault_Web.DAL
@inject SubmissionApiClient SubmissionClient

@{
    var currentUser = Context.GetUserName();
    var isSignedIn = !string.IsNullOrWhiteSpace(currentUser);
    var isAdmin = Context.IsAdmin();

    // Only the admin nav needs this, and it degrades to zero on failure.
    var pendingSubmissions = isAdmin ? await SubmissionClient.GetPendingCount() : 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ArcaneVault</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ArcaneVault_Web.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Announcement Banner -->
    <div class="announcement-bar">
        &#128230; Every item is IN STOCK &amp; ships within 1-3 business days &mdash; No preorders!
    </div>

    <!-- Site Header -->
    <header class="site-header">
        <div class="container">
            <div class="header-top">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <span class="brand-text">Arcane<span>Vault</span></span>
                </a>

                <form class="search-form d-none d-sm-flex" method="get"
                      asp-page="/CollectionItems/Available">
                    <label class="visually-hidden" for="header-search">Search</label>
                    <input id="header-search" class="form-control" type="search" name="Search"
                           placeholder="Search collectibles, figures, cards..." />
                </form>

                <div class="header-actions">
                    @if (isSignedIn)
                    {
                        <div class="header-icons">
                            @await Component.InvokeAsync("NavBadges")
                        </div>
                        <span class="header-greeting">Hi, @currentUser</span>
                        <a class="btn btn-outline-light" asp-page="/ChangePassword">Account</a>
                        <a class="btn btn-accent" asp-page="/Logout">Logout</a>
                    }
                    else
                    {
                        <a class="btn btn-outline-light" asp-page="/Login">Sign In</a>
                        <a class="btn btn-accent" asp-page="/Register">Sign Up</a>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- Navigation Bar -->
    <nav class="site-nav">
        <div class="container">
            <ul class="nav-links">
                <li><a asp-page="/Index">Home</a></li>
                <li><a asp-page="/CollectionItems/Available">Shop</a></li>
                @if (isSignedIn)
                {
                    <li><a asp-page="/Dashboard/Index">Dashboard</a></li>
                    <li><a asp-page="/CollectionItems/Index">My Collection</a></li>
                    <li><a asp-page="/Trades/Index">Trades</a></li>
                    <li><a asp-page="/Orders/Index">Orders</a></li>
                    <li><a asp-page="/SellWithUs/Index">Sell with Us</a></li>
                }
                else
                {
                    <li><a asp-page="/SellWithUs/Index">Sell with Us</a></li>
                }

                @if (isAdmin)
                {
                    <li class="nav-divider" aria-hidden="true"></li>
                    <li>
                        <a asp-page="/Admin/Analytics" class="nav-admin">Insights</a>
                    </li>
                    <li>
                        @* Category CRUD is admin-only, so it is not offered to
                           regular users, who browse categories via the shop. *@
                        <a asp-page="/Categories/Index" class="nav-admin">Categories</a>
                    </li>
                    <li>
                        <a asp-page="/Admin/Submissions" class="nav-admin">
                            Approvals
                            @if (pendingSubmissions > 0)
                            {
                                <span class="nav-badge">@pendingSubmissions</span>
                            }
                        </a>
                    </li>
                    <li>
                        <a asp-page="/CatalogItems/Index" class="nav-admin">Manage Items</a>
                    </li>
                }
            </ul>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="site-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col">
                    <h4>Shop</h4>
                    <a asp-page="/CollectionItems/Available">All Items</a>
                    <a asp-page="/CollectionItems/Available" asp-route-Sort="newest">New Arrivals</a>
                    <a asp-page="/Wishlist/Index">My Wishlist</a>
                    <a asp-page="/Cart/Index">Cart</a>
                </div>
                <div class="footer-col">
                    <h4>Collecting</h4>
                    <a asp-page="/Dashboard/Index">Dashboard</a>
                    <a asp-page="/CollectionItems/Index">My Collection</a>
                    <a asp-page="/Trades/Index">Trades</a>
                    <a asp-page="/Orders/Index">Orders</a>
                </div>
                <div class="footer-col">
                    <h4>Selling</h4>
                    <a asp-page="/SellWithUs/Index">List an Item</a>
                    <a asp-page="/SellWithUs/MyListings">My Listings</a>
                </div>
                <div class="footer-col">
                    <h4>Account</h4>
                    @if (isSignedIn)
                    {
                        <a asp-page="/Notifications/Index">Notifications</a>
                        <a asp-page="/ChangePassword">Change Password</a>
                        <a asp-page="/Logout">Sign Out</a>
                    }
                    else
                    {
                        <a asp-page="/Login">Sign In</a>
                        <a asp-page="/Register">Create Account</a>
                    }
                    <a asp-page="/Privacy">Privacy Policy</a>
                </div>
            </div>
            <div class="footer-bottom">
                &copy; 2026 ArcaneVault. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

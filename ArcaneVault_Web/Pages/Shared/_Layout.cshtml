@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ArcaneVault_Web</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ArcaneVault_Web.styles.css" asp-append-version="true" />
</head>
<body class="theme-collectible">
    <header class="site-header bg-white shadow-sm">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between py-2">
                <div class="d-flex align-items-center gap-3">
                    <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                        <img src="~/images/logo-placeholder.png" alt="Logo" style="height:36px;width:auto;" />
                        <span class="brand-text">ArcaneVault</span>
                    </a>
                    <nav class="d-none d-md-block">
                        <a class="nav-link d-inline-block" asp-page="/Index">Home</a>
                        <a class="nav-link d-inline-block" asp-page="/CollectionItems/Available">Available</a>
                        <a class="nav-link d-inline-block" asp-page="/CollectionItems/Index">My Collection</a>
                    </nav>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <form class="d-none d-sm-flex search-form" method="get" asp-page="/Search">
                        <input class="form-control" type="search" name="q" placeholder="Search collectibles, cards, comics..." />
                    </form>

                    <div class="header-actions d-flex align-items-center gap-2">
                        <a class="btn btn-sm btn-outline-secondary" asp-page="/Login">Sign in</a>
                        <a class="btn btn-primary btn-sm" asp-page="/Register">Sign up</a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="site-main">
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </main>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ArcaneVault_Web - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

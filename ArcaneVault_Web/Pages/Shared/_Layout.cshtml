@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ArcaneVault</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ArcaneVault_Web.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Announcement Banner -->
    <div class="announcement-bar">
        &#x1F4E6; Every item is IN STOCK &amp; ships within 1-3 business days — No preorders!
    </div>

    <!-- Site Header -->
    <header class="site-header">
        <div class="container">
            <div class="header-top">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <span class="brand-text">Arcane<span>Vault</span></span>
                </a>

                <form class="search-form d-none d-sm-flex" method="get" asp-page="/CollectionItems/Available">
                    <input class="form-control" type="search" name="SearchString"
                           placeholder="Search collectibles, figures, cards..." />
                </form>

                <div class="header-actions">
                    @if (Context.Session.GetString("UserName") != null)
                    {
                        <span style="color: var(--text-secondary); font-size: 0.85rem;">
                            Hi, @Context.Session.GetString("UserName")
                        </span>
                        <a class="btn btn-outline-light" asp-page="/ChangePassword">Account</a>
                        <a class="btn btn-accent" asp-page="/Logout">Logout</a>
                    }
                    else
                    {
                        <a class="btn btn-outline-light" asp-page="/Login">Sign In</a>
                        <a class="btn btn-accent" asp-page="/Register">Sign Up</a>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- Navigation Bar -->
    <nav class="site-nav">
        <div class="container">
            <ul class="nav-links">
                <li><a asp-page="/Index">Home</a></li>
                <li><a asp-page="/CollectionItems/Available">Shop All</a></li>
                <li><a asp-page="/CollectionItems/Index">My Collection</a></li>
                <li><a asp-page="/Categories/Index">Categories</a></li>
                <li><a asp-page="/SellWithUs/Index">Sell with Us</a></li>
                @if (Context.Session.GetInt32("RoleId") == 1)
                {
                    <li><a asp-page="/CatalogItems/Index">Manage Items</a></li>
                }
                <li><a asp-page="/Privacy">Privacy</a></li>
            </ul>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="site-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col">
                    <h4>Shop</h4>
                    <a asp-page="/CollectionItems/Available">All Items</a>
                    <a asp-page="/Categories/Index">Categories</a>
                    <a asp-page="/CollectionItems/Index">My Collection</a>
                </div>
                <div class="footer-col">
                    <h4>Account</h4>
                    <a asp-page="/Login">Sign In</a>
                    <a asp-page="/Register">Create Account</a>
                    <a asp-page="/ChangePassword">Change Password</a>
                </div>
                <div class="footer-col">
                    <h4>Info</h4>
                    <a asp-page="/Privacy">Privacy Policy</a>
                    <a href="#">Shipping Info</a>
                    <a href="#">FAQ</a>
                </div>
                <div class="footer-col">
                    <h4>ArcaneVault</h4>
                    <p style="color: var(--text-muted); font-size: 0.85rem; margin: 0;">
                        Your trusted destination for rare collectibles, 
                        action figures, cards, and pop culture memorabilia.
                    </p>
                </div>
            </div>
            <div class="footer-bottom">
                &copy; 2026 ArcaneVault. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
